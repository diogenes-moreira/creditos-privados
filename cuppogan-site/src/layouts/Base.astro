---
import { contact, whatsappLink } from "../site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#06673D" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="CuppoGan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-cuppogan.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CuppoGan" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>

    <header class="site-header">
      <div class="container header-row">
        <a href="/" class="logo" aria-label="CuppoGan, inicio">
          <img src="/brand/cuppogan-logo.png" alt="CuppoGan" width="150" height="49" />
        </a>
        <nav aria-label="Principal" class="nav">
          <a href="/#como-funciona">Cómo funciona</a>
          <a href="/#requisitos">Requisitos</a>
          <a href="/#preguntas">Preguntas</a>
        </nav>
        <a class="btn btn-primary btn-sm" href={whatsappLink()} rel="noopener"
          ><span class="long">Escribir por </span>WhatsApp</a
        >
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <img src="/brand/cuppogan-logo.png" alt="CuppoGan" width="140" height="46" class="footer-logo" />
          <p class="muted footer-about">
            Programa de compra de insumos ganaderos a plazos en TVGAN, promovido por FEDEGÁN, con la tecnología de
            evaluación Cuppo.
          </p>
        </div>
        <div>
          <h2 class="footer-title">Contacto</h2>
          <ul class="footer-list">
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li>WhatsApp oficial: <a href={whatsappLink()} rel="noopener">{contact.whatsappDisplay}</a></li>
            <li>{contact.address}</li>
          </ul>
        </div>
        <div>
          <h2 class="footer-title">Legal</h2>
          <ul class="footer-list">
            <li><a href="/terminos">Términos y Condiciones</a></li>
            <li><a href="/privacidad">Política de Tratamiento de Datos</a></li>
            <li><a href="https://www.sic.gov.co" rel="noopener">Superintendencia de Industria y Comercio</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {year} Programa CuppoGan, TVGAN S.A.S.</span>
        <span>TVGAN nunca le pedirá claves ni pagos en cuentas que no sean de su titularidad.</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --deep: #06673d;
    --deep-dark: #044b2c;
    --mid: #267e37;
    --growth: #398e33;
    --graphite: #2d3131;
    --muted: #5c6160;
    --cream: #f4f2eb;
    --mint: #e4efe0;
    --line: rgba(45, 49, 49, 0.14);
    --gradient: linear-gradient(90deg, #06673d 0%, #398e33 100%);
    --measure: 64ch;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: 1.0625rem;
    color: var(--graphite);
    background: #fff;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "cv11", "ss01";
  }
  img {
    max-width: 100%;
    height: auto;
  }
  a {
    color: var(--deep);
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 3px solid var(--growth);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .muted {
    color: var(--muted);
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: #fff;
    padding: 8px 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 10px;
    padding: 15px 24px;
    font-size: 1rem;
    line-height: 1.2;
    transition: background-color 0.15s;
  }
  .btn-primary {
    background: var(--deep);
    color: #fff;
  }
  .btn-primary:hover {
    background: var(--deep-dark);
  }
  .btn-light {
    background: #fff;
    color: var(--deep);
  }
  .btn-light:hover {
    background: var(--cream);
  }
  .btn-sm {
    padding: 10px 16px;
    font-size: 0.92rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--line);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 70px;
  }
  .logo img {
    display: block;
    width: 150px;
    height: auto;
  }
  .nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }
  .nav a {
    color: var(--graphite);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: var(--deep);
  }
  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .header-row .btn {
      margin-left: auto;
    }
    .header-row .long {
      display: none;
    }
    .logo img {
      width: 124px;
    }
  }

  .site-footer {
    background: var(--cream);
    padding: 56px 0 28px;
    font-size: 0.93rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .footer-logo {
    width: 140px;
  }
  .footer-about {
    max-width: 36ch;
  }
  .footer-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 12px;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .footer-list a {
    color: var(--graphite);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
