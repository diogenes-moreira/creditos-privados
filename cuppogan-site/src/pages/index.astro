---
import Base from "../layouts/Base.astro";
import { contact, whatsappLink } from "../site";

// Everything on this page must stay within what the Terms (v1.0) allow it to
// say: no amounts, rates or terms of any cupo, which are only informed
// personally over WhatsApp before each purchase (Terms §3 and §7).

const steps = [
  {
    title: "Escríbanos por WhatsApp",
    text: "Déjenos su interés en la línea oficial de CuppoGan. Un asesor de TVGAN lo contacta.",
  },
  {
    title: "Valide su identidad",
    text: "Con su autorización, verificamos su identidad y consultamos su registro en el RUV y en centrales de riesgo.",
  },
  {
    title: "Conozca su cupo",
    text: "Le informamos de manera personal, por WhatsApp, el monto y las condiciones de su cupo antes de que usted decida.",
  },
  {
    title: "Compre y pague a plazos",
    text: "Compre insumos en TVGAN, en la tienda digital o con su asesor, y pague en cuotas desde la entrega.",
  },
];

const requirements = [
  "Ser persona natural mayor de edad, con cédula de ciudadanía.",
  "Ser comprador de TVGAN.",
  "Tener su predio ganadero registrado en el Registro Único de Vacunación (RUV).",
];

const benefits = [
  {
    title: "Condiciones claras antes de comprar",
    text: "Antes de cada compra recibe por escrito el precio de contado, el plazo, las cuotas y la tasa efectiva anual, que nunca supera la tasa de usura vigente.",
  },
  {
    title: "Pague antes, sin penalidad",
    text: "Puede pagar en cualquier momento, total o parcialmente, y solo se liquida el cargo financiero causado hasta ese día.",
  },
  {
    title: "Sin intereses sobre intereses",
    text: "Los pagos se aplican primero a la compra más antigua y nunca se cobran intereses sobre intereses.",
  },
  {
    title: "Compre como prefiera",
    text: "Use su cupo en la tienda digital de TVGAN o con su asesor comercial por WhatsApp.",
  },
];

const faqs = [
  {
    q: "¿CuppoGan es un préstamo?",
    a: "No. CuppoGan no entrega dinero ni permite retiros. Es un cupo para comprar insumos productivos ganaderos en TVGAN y pagarlos a plazos.",
  },
  {
    q: "¿Qué puedo comprar con mi cupo?",
    a: "Insumos productivos ganaderos de TVGAN. El cupo no se puede usar para comprar ganado en pie, retirar efectivo ni para gastos personales.",
  },
  {
    q: "¿Escribir por WhatsApp me obliga a algo?",
    a: "No. Dejar sus datos no genera ninguna obligación para usted ni garantiza la asignación de un cupo. Sus obligaciones solo nacen de las compras que usted confirme.",
  },
  {
    q: "¿Por qué se consulta el RUV?",
    a: "El Registro Único de Vacunación, que custodia FEDEGÁN, permite conocer su inventario ganadero para determinar su cupo. Solo se consulta con su autorización previa.",
  },
  {
    q: "¿Cómo sé que me contacta CuppoGan?",
    a: `El WhatsApp oficial de CuppoGan es ${contact.whatsappDisplay}. TVGAN nunca le pedirá claves ni que pague en cuentas que no sean de su titularidad.`,
  },
  {
    q: "¿Qué pasa si me atraso en un pago?",
    a: "Recibirá avisos antes y después del vencimiento. Mientras exista una cuota en mora el cupo se suspende para nuevas compras, y antes de cualquier reporte a centrales de riesgo se le avisa con al menos veinte días.",
  },
];

const participants = [
  { name: "TVGAN", role: "Vende los insumos, aprueba los cupos y recibe los pagos." },
  { name: "FEDEGÁN", role: "Promueve el programa entre los ganaderos y custodia el RUV." },
  { name: "Cuppo", role: "Tecnología de evaluación de TechX Latam, operador tecnológico del programa." },
];
---

<Base
  title="CuppoGan | Insumos para su hato, pagados a plazos"
  description="CuppoGan es el programa para que los ganaderos compren insumos productivos en TVGAN con un cupo preaprobado y pago a plazos. Escríbanos por WhatsApp."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Programa promovido por FEDEGÁN</p>
        <h1>Insumos para su hato hoy, pagados a plazos</h1>
        <p class="lead">
          Con CuppoGan, los ganaderos compran insumos productivos en TVGAN con un cupo preaprobado y pagan en cuotas,
          con las condiciones claras antes de cada compra.
        </p>
        <div class="hero-actions">
          <a class="btn btn-light" href={whatsappLink()} rel="noopener">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
            Quiero activar mi beneficio
          </a>
          <a class="btn btn-outline-light" href="#como-funciona">Cómo funciona</a>
        </div>
      </div>
      <div class="hero-card" aria-hidden="true">
        <img src="/brand/cuppogan-symbol.png" alt="" width="66" height="80" class="hero-mark" />
        <ul>
          <li>Cupo preaprobado para insumos</li>
          <li>Pago en cuotas desde la entrega</li>
          <li>Compre por WhatsApp o en la tienda digital</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="participants">
    <div class="container participants-grid">
      {
        participants.map((p) => (
          <div>
            <strong>{p.name}</strong>
            <span>{p.role}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section id="que-es" class="section">
    <div class="container narrow center">
      <p class="eyebrow dark">Qué es CuppoGan</p>
      <h2>Financiación para producir, no para endeudarse</h2>
      <p class="muted big">
        CuppoGan no es un préstamo en efectivo. TVGAN le vende el insumo y difiere el pago en el tiempo, con base en
        un cupo asignado después de su autorización y de la validación de su identidad. Usted solo se obliga por las
        compras que confirma.
      </p>
    </div>
  </section>

  <section id="como-funciona" class="section cream">
    <div class="container">
      <div class="center narrow">
        <p class="eyebrow dark">Cómo funciona</p>
        <h2>Cuatro pasos, todo por WhatsApp</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="requisitos" class="section">
    <div class="container split">
      <div>
        <p class="eyebrow dark">Requisitos</p>
        <h2>¿Quién puede acceder?</h2>
        <p class="muted">
          Si no cumple alguno de estos criterios, igual puede escribirnos y le contamos las opciones disponibles.
        </p>
      </div>
      <ul class="checks">
        {
          requirements.map((r) => (
            <li>
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
              <span>{r}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <div class="center narrow">
        <p class="eyebrow dark">Sus derechos</p>
        <h2>Transparencia en cada compra</h2>
      </div>
      <div class="benefits">
        {
          benefits.map((b) => (
            <article>
              <h3>{b.title}</h3>
              <p class="muted">{b.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="section">
    <div class="container narrow">
      <div class="center">
        <p class="eyebrow dark">Preguntas frecuentes</p>
        <h2>Lo que más nos preguntan</h2>
      </div>
      <div class="faqs">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <h2>¿Listo para activar su beneficio?</h2>
        <p>Escríbanos al WhatsApp oficial de CuppoGan y un asesor de TVGAN lo contacta.</p>
      </div>
      <a class="btn btn-light" href={whatsappLink()} rel="noopener">Escribir a {contact.whatsappDisplay}</a>
    </div>
    <p class="container cta-legal">
      TVGAN S.A.S. es responsable del tratamiento de sus datos y TechX Latam S.A.S. es encargado, conforme a la Ley 1581
      de 2012 y a la <a href="/privacidad">Política de Tratamiento de Datos</a>. Ninguna información de esta página
      constituye oferta, cotización ni promesa de condiciones. Consulte los <a href="/terminos"
        >Términos y Condiciones</a
      >.
    </p>
  </section>
</Base>

<style>
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.85);
  }
  .eyebrow.dark {
    color: var(--growth);
  }
  h1,
  h2,
  h3 {
    line-height: 1.15;
    margin: 0;
  }
  h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .center {
    text-align: center;
  }
  .narrow {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .big {
    font-size: 1.1rem;
  }
  .section {
    padding: 88px 0;
  }
  .section.cream {
    background: var(--cream);
  }

  .hero {
    background: var(--gradient);
    color: #fff;
    padding: 88px 0 96px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .lead {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 560px;
    margin: 0 0 32px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-card {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 32px;
  }
  .hero-mark {
    display: block;
    width: 72px;
    height: auto;
    box-sizing: content-box;
    padding: 12px 15px;
    background: #fff;
    border-radius: 16px;
    margin-bottom: 24px;
  }
  .hero-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    font-weight: 600;
  }
  .hero-card li {
    padding-left: 28px;
    position: relative;
  }
  .hero-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
  }

  .participants {
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
  }
  .participants-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .participants-grid div {
    display: grid;
    gap: 2px;
  }
  .participants-grid strong {
    color: var(--deep);
    font-size: 1.05rem;
  }
  .participants-grid span {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .steps li {
    background: #fff;
    border-radius: var(--radius);
    padding: 28px 24px;
    border: 1px solid var(--line);
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--deep);
    color: #fff;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .steps p,
  .benefits p {
    margin: 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .checks li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--cream);
    border-radius: var(--radius);
    padding: 18px 20px;
    font-weight: 600;
  }
  .checks svg {
    color: var(--deep);
    flex: none;
    margin-top: 2px;
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 48px;
  }
  .benefits article {
    background: #fff;
    border-radius: var(--radius);
    padding: 28px;
    border-left: 4px solid var(--growth);
  }

  .faqs {
    margin-top: 40px;
    display: grid;
    gap: 12px;
  }
  details {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0 22px;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    padding: 18px 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--deep);
    font-size: 1.4rem;
    line-height: 1;
  }
  details[open] summary::after {
    content: "−";
  }
  details p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .cta {
    background: var(--deep);
    color: #fff;
    padding: 64px 0 40px;
  }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cta h2 {
    margin-bottom: 8px;
  }
  .cta p {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
  }
  .cta-legal {
    margin-top: 36px !important;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7) !important;
  }
  .cta-legal a {
    color: #fff;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .section {
      padding: 64px 0;
    }
    .hero {
      padding: 56px 0 64px;
    }
    .steps,
    .benefits,
    .participants-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .cta-inner .btn {
      width: 100%;
      white-space: normal;
    }
  }
</style>
