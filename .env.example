# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=creditos
DB_PASSWORD=creditos_secret
DB_NAME=creditos

# Deployment country: AR (Argentina) or CO (Colombia).
# Drives identity validation (DNI/CUIT vs Cédula/NIT), currency (ARS vs COP),
# locale, timezone and the default IVA rate (AR=21, CO=19).
COUNTRY=AR

# Optionally override the country's default IVA rate (percentage).
# DEFAULT_IVA_RATE=21

# Server
SERVER_PORT=8080
GIN_MODE=debug

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# Firebase (optional for local dev)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=

# Google Cloud Storage (optional for local dev)
GCS_BUCKET=
GCS_CREDENTIALS_FILE=

# Local storage fallback
LOCAL_STORAGE_PATH=./storage

# OTP delivery channel: "kapso", "twilio" or "sendgrid".
# Empty uses whichever is configured, preferring WhatsApp over email.
OTP_PROVIDER=

# OTP delivery over email (SendGrid).
# FROM_EMAIL must be a verified sender identity, or any address on a domain
# authenticated in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=CuppoGan

# OTP delivery over WhatsApp (Kapso).
# Kapso fronts the WhatsApp Cloud API with Meta's own request shape.
# PhoneNumberID is the connected number's id, not the number itself.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Approved template whose first body parameter {{1}} is the code. WhatsApp
# only allows free-form text inside an open 24h window, and an OTP is always
# business-initiated, so production needs this.
KAPSO_TEMPLATE_NAME=
KAPSO_TEMPLATE_LANGUAGE=es

# OTP delivery over WhatsApp (Twilio).
# With no credentials the OTP falls back to Firebase email links, and then to
# the console, so local development needs no Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio sender in E.164 (the sandbox number is +14155238886).
TWILIO_WHATSAPP_FROM=
# Approved Content template (HX...) carrying the code as variable {{1}}.
# WhatsApp requires a template for business-initiated messages, which an OTP
# always is; without it Twilio only delivers inside an open 24h window.
TWILIO_WHATSAPP_TEMPLATE_SID=

# Credit risk analysis (optional).
# The risk module works without any of these: with no API key it scores
# applicants with its deterministic scorecard, and the analysis prompt is not
# sent anywhere. Setting a key enables the prompt-driven analysis that admins
# manage from Settings > Risk model.
ANTHROPIC_API_KEY=
RISK_ANALYSIS_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max
RISK_ANALYSIS_EFFORT=high
RISK_ANALYSIS_MAX_TOKENS=16000
