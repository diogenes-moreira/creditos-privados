# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=creditos
DB_PASSWORD=creditos_secret
DB_NAME=creditos

# Deployment country: AR (Argentina) or CO (Colombia).
# Drives identity validation (DNI/CUIT vs Cédula/NIT), currency (ARS vs COP),
# locale, timezone and the default IVA rate (AR=21, CO=19).
COUNTRY=AR

# Optionally override the country's default IVA rate (percentage).
# DEFAULT_IVA_RATE=21

# Server
SERVER_PORT=8080
GIN_MODE=debug

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24


# Google Cloud Storage (optional for local dev)
GCS_BUCKET=
GCS_CREDENTIALS_FILE=

# Local storage fallback
LOCAL_STORAGE_PATH=./storage

# OTP delivery channel: "kapso", "twilio" or "sendgrid".
# Empty uses whichever is configured, preferring WhatsApp over email.
OTP_PROVIDER=

# OTP delivery over email (SendGrid).
# FROM_EMAIL must be a verified sender identity, or any address on a domain
# authenticated in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=CuppoGan

# OTP delivery over WhatsApp (Kapso).
# Kapso fronts the WhatsApp Cloud API with Meta's own request shape.
# PhoneNumberID is the connected number's id, not the number itself.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Approved template whose first body parameter {{1}} is the code. WhatsApp
# only allows free-form text inside an open 24h window, and an OTP is always
# business-initiated, so production needs this.
KAPSO_TEMPLATE_NAME=
KAPSO_TEMPLATE_LANGUAGE=es

# OTP delivery over WhatsApp (Twilio).
# With no credentials the OTP falls back to Firebase email links, and then to
# the console, so local development needs no Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio sender in E.164 (the sandbox number is +14155238886).
TWILIO_WHATSAPP_FROM=
# Approved Content template (HX...) carrying the code as variable {{1}}.
# WhatsApp requires a template for business-initiated messages, which an OTP
# always is; without it Twilio only delivers inside an open 24h window.
TWILIO_WHATSAPP_TEMPLATE_SID=

# Administrator sign-in with Google. The client id is public: it ships in the
# browser bundle by design and names the app, it does not authorise anything.
# Set GOOGLE_HOSTED_DOMAIN to restrict sign-in to one Workspace domain.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
VITE_GOOGLE_CLIENT_ID=

# Fedegán's vaccination registry (RUV), the alternative bureau the livestock
# quota engine underwrites on. Without these the engine still scores a herd a
# caller supplies; it just cannot read one.
# NOTE: the service is published over plain HTTP, so credentials and the
# rancher's personal data travel unencrypted. That is the provider's contract.
RUV_BASE_URL=
RUV_CLIENT_ID=
RUV_CLIENT_SECRET=
RUV_USERNAME=
RUV_PASSWORD=

# How the livestock quota is decided: "tiers" (the pilot's fixed amounts,
# default) or "engine" (the individual engine). An unknown value stops the
# server. The tiers measure the herd on one RUV cycle, as YYYY-C.
LIVESTOCK_QUOTA_STRATEGY=tiers
LIVESTOCK_QUOTA_CURRENT_CYCLE=2026-1

# TVGAN's Odoo (API /api/v1/cuppogan): the ledger of the livestock credit
# portfolio. Prestia reads each credit line's credit snapshot and quota
# invoices, registers payments and blocks/unblocks. Without the token (or the
# base URL) the portfolio features are off and the stored data stays readable.
# Test: https://tvgan-test-41617556.dev.odoo.com/api/v1/cuppogan
# Production needs its own token and Prestia's egress IP on Odoo's allowlist.
ODOO_API_BASE_URL=
ODOO_API_TOKEN=
ODOO_API_TIMEOUT_SECONDS=15
# Client-side throttle. Odoo allows 60/min and 600/h per IP, shared with
# CuppoGan's service (same egress IP), and each Cloud Run instance throttles
# on its own: keep (instances x limit) well under Odoo's.
ODOO_API_REQUESTS_PER_MINUTE=15
ODOO_API_REQUESTS_PER_HOUR=150
# Minutes between unattended syncs of every line (0 = off; the "Actualizar
# desde Odoo" button still works). A round stops when a quarter of the hourly
# budget is left, and resumes with the least recently synced lines.
ODOO_SYNC_INTERVAL_MINUTES=15

# Credit risk analysis (optional).
# The risk module works without any of these: with no API key it scores
# applicants with its deterministic scorecard, and the analysis prompt is not
# sent anywhere. Setting a key enables the prompt-driven analysis that admins
# manage from Settings > Risk model.
ANTHROPIC_API_KEY=
RISK_ANALYSIS_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max
RISK_ANALYSIS_EFFORT=high
RISK_ANALYSIS_MAX_TOKENS=16000
